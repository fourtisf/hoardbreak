{
  "name": "dragonjob",
  "private": true,
  "version": "0.3.0",
  "description": "THE DRAGON JOB \u2014 a mobile-first extraction-heist roguelite. Rob the dragon. Don't wake it.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @dragonjob/web dev",
    "build": "pnpm --filter @dragonjob/web build",
    "start": "pnpm --filter @dragonjob/web start",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @dragonjob/engine test",
    "typecheck": "pnpm -r typecheck",
    "test:meta": "pnpm --filter @dragonjob/shared test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
