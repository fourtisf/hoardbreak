{
  "name": "@quietgold/engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Framework-free QUIET GOLD game engine \u2014 lair generation, fixed-timestep simulation, canvas renderer.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./headless": {
      "types": "./src/headless.ts",
      "default": "./src/headless.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
